# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Database (Neon pooled URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_CONNECTION_LIMIT="1"
DATABASE_SESSION_OPTIONS="false"
# TLS cert verification (default: on). Set false only as a local escape hatch.
# DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# Session — openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# First platform admin. Used only by `pnpm db:seed` when no admin exists yet.
# After that, sign in with this email and password. Further admins are assigned in /admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-admin-password"

# Cloudflare R2 — card/chat photos & videos (max 200 MB)
# Create a bucket + S3 API token with Object Read & Write.
# CORS on the bucket (required for browser PUT):
#   AllowedOrigins: http://localhost:3000 and your APP_URL
#   AllowedMethods: GET, PUT, HEAD
#   AllowedHeaders: Content-Type
#   ExposeHeaders: ETag
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="nbos"
# Optional public/custom domain. Files are served via signed URLs; leave empty.
R2_PUBLIC_URL=""

# ——— Vercel Production ———
# DATABASE_URL=<Neon pooled URL with sslmode=require>
# DATABASE_CONNECTION_LIMIT=1
# DATABASE_SESSION_OPTIONS=false
# SESSION_SECRET=<openssl rand -hex 32>
# ADMIN_EMAIL=<first admin email>
# ADMIN_PASSWORD=<at least 10 characters>
# APP_URL=https://your-app.vercel.app
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=nbos
# R2_PUBLIC_URL=
