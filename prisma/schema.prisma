generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CardStatus {
  new
  in_progress
  answered
  done
}

enum CommentReactionEmoji {
  agree
  done
  watching
  question
  blocker
}

model Board {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  joinToken  String    @unique
  ownerId    String?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner        User?            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  invites      Invite[]
  participants Participant[]
  cards        Card[]
  attachments  Attachment[]
  labels       BoardLabel[]
  agentAccess  BoardAgentAccess?

  @@index([ownerId])
}

model BoardAgentAccess {
  id        String   @id @default(cuid())
  boardId   String   @unique
  keyHash   String   @unique
  keyPrefix String
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

model Invite {
  id            String    @id @default(cuid())
  token         String    @unique
  boardId       String
  claimedAt     DateTime?
  participantId String?   @unique
  createdAt     DateTime  @default(now())

  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([boardId])
}

model Participant {
  id          String   @id @default(cuid())
  boardId     String
  displayName String
  avatarKey   String?
  userId      String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  board            Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  invite           Invite?
  cards            Card[]
  comments         Comment[]
  attachments      Attachment[]
  commentReactions CommentReaction[]
  commentMentions  CommentMention[]

  @@index([boardId])
  @@index([boardId, lastSeenAt])
  @@index([userId])
  @@unique([boardId, avatarKey])
  @@unique([boardId, userId])
}

model Card {
  id              String     @id @default(cuid())
  boardId         String
  authorId        String
  status          CardStatus @default(new)
  title           String
  urgent          Boolean    @default(false)
  position        Int        @default(0)
  pinnedCommentId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  board         Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author        Participant  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  comments      Comment[]    @relation("CardComments")
  pinnedComment Comment?     @relation("CardPinnedComment", fields: [pinnedCommentId], references: [id], onDelete: SetNull)
  attachments   Attachment[]
  labels        CardLabel[]

  @@index([boardId, status])
  @@index([boardId, status, position])
  @@index([pinnedCommentId])
}

model BoardLabel {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards CardLabel[]

  @@unique([boardId, name])
  @@index([boardId, position])
}

model CardLabel {
  cardId  String
  labelId String

  card  Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label BoardLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

model Comment {
  id               String    @id @default(cuid())
  cardId           String
  authorId         String
  body             String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  editedAt         DateTime?
  deletedAt        DateTime?
  parentId         String?
  parentAuthorName String?
  parentExcerpt    String?

  card          Card               @relation("CardComments", fields: [cardId], references: [id], onDelete: Cascade)
  author        Participant        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments   Attachment[]
  parent        Comment?           @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies       Comment[]          @relation("CommentReplies")
  pinnedOnCards Card[]             @relation("CardPinnedComment")
  reactions     CommentReaction[]
  mentions      CommentMention[]

  @@index([cardId, createdAt])
  @@index([cardId, deletedAt])
  @@index([parentId])
}

model CommentReaction {
  id            String               @id @default(cuid())
  commentId     String
  participantId String
  emoji         CommentReactionEmoji
  createdAt     DateTime             @default(now())

  comment     Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([commentId, participantId, emoji])
  @@index([commentId])
}

model CommentMention {
  id            String   @id @default(cuid())
  commentId     String
  participantId String
  createdAt     DateTime @default(now())

  comment     Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([commentId, participantId])
  @@index([participantId])
}

enum AttachmentKind {
  image
  video
  audio
}

enum UserRole {
  member
  platform_admin
}

enum AuthEmailPurpose {
  verify_email
  reset_password
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  displayName      String
  role             UserRole  @default(member)
  emailVerifiedAt  DateTime?
  disabledAt       DateTime?
  sessionVersion   Int       @default(0)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ownedBoards     Board[]
  participants    Participant[]
  auditEvents     AdminAudit[]
  authEmailTokens AuthEmailToken[]

  @@index([role])
}

model AuthEmailToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthEmailPurpose
  tokenHash String           @unique
  expiresAt DateTime
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model AdminAudit {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

model Attachment {
  id          String         @id @default(cuid())
  boardId     String
  cardId      String
  commentId   String?
  authorId    String
  objectKey   String         @unique
  filename    String
  contentType String
  byteSize    Int
  kind        AttachmentKind
  createdAt   DateTime       @default(now())

  board   Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card    Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  comment Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author  Participant  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([cardId, createdAt])
  @@index([commentId])
  @@index([boardId])
}
